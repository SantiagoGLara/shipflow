# PostgreSQL
POSTGRES_DB=shipflow
POSTGRES_USER=shipflow
POSTGRES_PASSWORD=change_me_postgres

# MongoDB (el contenedor escucha 27017 internamente y 27018 en el host)
MONGO_DATABASE=shipflow
MONGO_USER=shipflow
MONGO_PASSWORD=change_me_mongo
MONGODB_URI=mongodb://shipflow:change_me_mongo@localhost:27018/shipflow?authSource=admin

# JWT: usa un secreto aleatorio largo (mínimo 32 bytes)
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_bytes

# Outbox (opcionales)
OUTBOX_POLL_MS=3000
OUTBOX_BATCH_SIZE=25
OUTBOX_MAX_ATTEMPTS=8
